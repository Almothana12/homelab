{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Invidious tracks rolling tags (master/latest) pinned by digest; take every new build and automerge it",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "quay.io/invidious/invidious",
        "quay.io/invidious/invidious-companion"
      ],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "llama.cpp tags are <flavor>-<cuda>-b<build>. Docker versioning cannot parse 'server-cuda13-b11515' (skipReason=invalid-value, so no PRs ever), so parse the build number as the comparable part",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ggml-org/llama.cpp"],
      "versioning": "regex:^(?<compatibility>.*)b(?<major>\\d+)$"
    }
  ],
  "flux": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/",
      "/apps/.+\\.yaml$/",
      "/infrastructure/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/k8s/.+\\.yaml$/",
      "/apps/.+\\.yaml$/",
      "/infrastructure/.+\\.yaml$/"
    ],
    "packageRules": [
      {
        "matchUpdateTypes": [
          "minor",
          "patch"
        ],
        "matchCurrentVersion": "!/^0/",
        "automerge": true
      }
    ]
  }
}
