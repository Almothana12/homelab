# Engine switches of the measured recipe, the same on both ranks. Source:
# github.com/HeNryous/deepseek-v41-1017-dgx-spark serve/serve_example.sh (DOCKER_ENV, image v24) on top
# of github.com/sudoingX/dgx-spark-deepseek-v41 cc59c36 scripts/launch/dsv41_tp2.sh (RECIPE_ENV and
# the docker run -e list). Left out: the KV offload (0056/0058/0077/0081) and the background-priority
# switches (0031/0071-0074), which do nothing unless clients send a `priority`.
# Not here: EXL3_RDMA_DEVICES / EXL3_RDMA_GID / *_SOCKET_IFNAME, which bootstrap.py discovers.

# vLLM
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_DISABLED_KERNELS=FlashInferCutlassMxfp8LinearKernel
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TORCH_EXTENSIONS_DIR=/data/torch_extensions

# NCCL over the direct rail (same settings as qwen-38-flash-next, plus the recipe's tuning)
NCCL_SOCKET_FAMILY=AF_INET
NCCL_IB_DISABLE=0
NCCL_NET=IB
NCCL_IB_HCA==mlx5_2:1
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ADDR_RANGE=10.100.217.0/24
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_PROTO=^LL128
NCCL_CUMEM_ENABLE=0
NCCL_CUMEM_HOST_ENABLE=0
NCCL_DEBUG=INFO

# EXL3 MoE plugin and DSpark speculative decoding (sudoingX RECIPE_ENV)
VLLM_EXL3_MOE_PARALLEL_GROUPS=1
EXL3_MOE_COOP_WIDE=1
EXL3_INT8_GEMV=0
VLLM_DSPARK_DEPTH_POLICY=conf
VLLM_DSPARK_DRAFT_MS=0
VLLM_DSPARK_MARKOV_CACHE=/opt/dsv41/markov_top_tokens.json
EXL3_L2PF=attn,moe,next
EXL3_RDMA_AR=1
VLLM_SHORT_CTX_BOUNDS=512,1025
EXL3_ROUTER=1
EXL3_L2PF_HC=1
VLLM_DSPARK_LOCAL_ARGMAX=1
EXL3_SMOE_FLAGS=-DSMOE_RUNFLAGS=1
VLLM_DSV41_MHC_OVERLAP=1
VLLM_ENGRAM_DISK_SPIN_MS=1000
EXL3_MROW_GROUPED=1
VLLM_EXL3_MOE_TF_PROMPT=1

# HeNryous v24 switches (DOCKER_ENV); the round-cost table was measured at 2000 MHz
VLLM_DSPARK_ROUND_MS=33.26,36.33,38.91,42.23,46.03,48.15
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=128
VLLM_INDEXER_TP_SHARD_MIN_ROWS=2048
# Cortex-A725 efficiency core for the RDMA poller; vLLM threads on the X925 cores.
EXL3_RDMA_CPU=14
EXL3_CPU_PIN=5-9,15-19
EXL3_RDMA_AG=1
EXL3_RDMA_AG_MAX_KB=3072
VLLM_EXL3_HEAD_MROW=1
EXL3_HEAD_MROW_MAX_ROWS=8
VLLM_EXL3_MROW_MAX_ROWS=32
EXL3_MROW32_VARIANT=ring
EXL3_MROW32_MIN_ROWS=9
VLLM_MOE_GATE_FIRST=1
VLLM_EXL3_MOE_SMOE_SHARED=1
VLLM_DSV41_MHC_FUSED_POST=2
VLLM_DSV41_MHC_OVERLAP_MAX_TOKENS=24
VLLM_DSV41_ADAPTIVE_K=1
VLLM_DSV41_AK_MARGIN=1.0
VLLM_DSV41_AK_MIN=2
VLLM_DSV41_AK_HI=1.6
VLLM_DSV41_AK_MAX_REQS=4
VLLM_DSV41_KV_PAIR=3
VLLM_DSV41_KV_SWA_FILL=1
VLLM_DSV41_INDEXER_DEFER=1
VLLM_EXL3_MOE_SPLIT_MAX_TOKENS=63
VLLM_DSV41_MARKOV_FUSED=1
VLLM_DSV41_VOR_FUSED=1
VLLM_DSV41_REPLAY_SKIP=1
VLLM_DSV41_ENGRAM_LOOKAHEAD=4096
VLLM_INDEXER_PREFILL_BUFFER_FACTOR=4
VLLM_DSV41_DROP_MTP_BUFFER=1
VLLM_EXL3_TF_PROMPT_TRANSIENT=1
VLLM_EXL3_TF_PROMPT_ALIAS=1
